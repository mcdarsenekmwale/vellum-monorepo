# =============================================================================
# VELLUM MOBILE APP — ENVIRONMENT CONFIGURATION
# Copy this file to .env for local development.
# Expo automatically loads .env in dev mode and .env.production in builds.
# Variables must be prefixed with EXPO_PUBLIC_ to be available in client code.
# =============================================================================

# -----------------------------------------------------------------------------
# API Base URL — must point to the Vellum backend API
# -----------------------------------------------------------------------------

# Development — local backend (iOS simulator can access localhost)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001

# For Android emulator, use: http://10.0.2.2:3001
# For physical device, use your machine's LAN IP: http://192.168.x.x:3001

# Production — deployed backend API (Prisma Build)
# EXPO_PUBLIC_API_BASE_URL=https://cmrfcrfjq1g65wfdvx0g77d3v.ewr.prisma.build
