# =============================================================================
# VELLUM WEBAPP — ENVIRONMENT CONFIGURATION
# Copy this file to .env for local development.
# Vite automatically loads .env in dev mode and .env.production in builds.
# =============================================================================

# -----------------------------------------------------------------------------
# API Base URL — must point to the Vellum backend API
# -----------------------------------------------------------------------------

# Development — local backend
VITE_API_BASE_URL=http://localhost:3001

# Production — deployed backend API (Prisma Build)
# VITE_API_BASE_URL=https://cmrfcrfjq1g65wfdvx0g77d3v.ewr.prisma.build
