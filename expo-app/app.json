{
  "expo": {
    "name": "Vellum",
    "slug": "vellum",
    "scheme": "vellum",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.vellum.mobile" },
    "android": { "package": "app.vellum.mobile" },
    "web": { "bundler": "metro" },
    "plugins": ["expo-router", "expo-font"],
    "experiments": { "typedRoutes": true }
  }
}
