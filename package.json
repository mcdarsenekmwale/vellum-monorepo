{
  "name": "vellbase-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:api",
    "dev:api": "cd packages/api && npm run start:dev",
    "dev:web": "cd apps/web-app && npm run dev",
    "dev:mobile": "cd apps/mobile-app && npm run start",
    "build:api": "cd packages/api && npm run build",
    "build:web": "cd apps/web-app && npm run build",
    "build:admin": "cd apps/admin-dashboard && npm run build",
    "build:mobile": "cd apps/mobile-app && npm run build",
    "dev:admin": "cd apps/admin-dashboard && npm run dev",
    "build:packages": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:e2e": "cd tests/e2e && npx tsc --noEmit",
    "test": "npm run test:api:unit && npm run test:frontend",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:api:unit": "npm -w packages/api run test:unit",
    "test:api:integ": "npm -w packages/api run test:integ",
    "test:api:integrity": "npm -w packages/api run test:integrity",
    "test:api:cov": "npm -w packages/api run test:cov",
    "test:admin:unit": "npm -w @vellbase/admin-dashboard run test",
    "test:web:unit": "npm -w @vellbase/web-app run test",
    "test:frontend": "npm run test:admin:unit && npm run test:web:unit",
    "test:playwright": "npx playwright test --config playwright-t9.config.ts",
    "test:axe": "npx playwright test tests/axe-d/screens.spec.ts --config playwright-axe.config.ts",
    "test:perf": "bash .ai-verify/perf-d/run-perf-d.sh",
    "test:sec": "bash .ai-verify/sec-d/run-sec-d.sh",
    "test:integrity": "bash .ai-verify/integrity-d/run-integrity.sh",
    "db:migrate": "cd packages/api && npx prisma migrate dev",
    "db:seed": "cd packages/api && npx prisma db seed",
    "db:generate": "cd packages/api && npx prisma generate",
    "db:studio": "cd packages/api && npx prisma studio"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.61.1"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native-worklets": "0.5.1"
  }
}
