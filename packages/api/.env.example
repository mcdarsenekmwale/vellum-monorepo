# =============================================================================
# VELLUM BACKEND — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in the values for your environment
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# Database (Prisma)
# -----------------------------------------------------------------------------
# Development — local PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/vellum?schema=public"

# Production — Prisma Data Platform / Neon / Railway / etc.
# DATABASE_URL="postgresql://..."

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_ACCESS_TOKEN_EXPIRES_IN="15m"
JWT_REFRESH_TOKEN_EXPIRES_IN="7d"

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS="12"

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT="3001"

# -----------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins
# -----------------------------------------------------------------------------
# Development
CORS_ORIGIN="http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084,http://localhost:8085,http://localhost:8086,http://localhost:8087,http://localhost:8088,http://localhost:8089,http://localhost:19006"

# Production — update with your deployed frontend URL(s)
# CORS_ORIGIN="https://your-vercel-app.vercel.app,https://your-custom-domain.com"

# -----------------------------------------------------------------------------
# Cache / Redis
# -----------------------------------------------------------------------------
# Development — local Redis (or fallback to in-memory)
REDIS_URL="redis://localhost:6379"

# Production — Redis Cloud / Upstash / Railway / etc.
# REDIS_URL="redis://default:password@your-redis-host:port"
