# =============================================================================
# VELLUM API — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in the values for your environment
# =============================================================================

# Application
NODE_ENV=development
PORT=3001

# Database (local — expected local DB name: vellum_db on 127.0.0.1:5432)
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/vellum_db?schema=public
# DIRECT_URL= (optional, for prisma migrations when using data proxy — set same as DATABASE_URL for local)

# Redis (optional — for caching. Local default: 127.0.0.1:6379)
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Alternative single-URL form (overrides HOST/PORT if set)
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_PASSWORD=
# REDIS_USER=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8080,https://vellbase-monorepo-webapp.vercel.app

# Bcrypt
BCRYPT_ROUNDS=12
