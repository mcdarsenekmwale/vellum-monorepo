# =============================================================================
# VELLUM API — ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in the values for your environment
# =============================================================================

# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vellum?schema=public

# Redis (optional — for caching)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_IN=15m

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:8080,https://vellum-monorepo-webapp.vercel.app

# Bcrypt
BCRYPT_ROUNDS=12
