{
  "name": "@vellbase/api",
  "version": "1.0.0",
  "description": "Vellbase Backend API",
  "main": "dist/src/main.js",
  "scripts": {
    "build": "prisma generate && nest build && node scripts/copy-swagger-ui.js",
    "postbuild": "node scripts/copy-swagger-ui.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:unit": "jest --config ./jest.config.ts --testPathIgnorePatterns=integ",
    "test:integ": "jest --config ./jest.config.ts __tests__/integ/ --testPathIgnorePatterns=integrity",
    "test:integrity": "jest --config ./jest.config.ts __tests__/integrity/",
    "test:cov": "jest --config ./jest.config.ts --coverage --testPathIgnorePatterns=integ,integrity",
    "test:e2e": "jest --config jest-e2e.json --passWithNoTests",
    "migrate:dev": "prisma migrate dev",
    "migrate:prod": "prisma migrate deploy",
    "migrate:generate": "prisma migrate generate",
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts && ts-node -r tsconfig-paths/register prisma/seed-rbac.ts",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:studio": "prisma studio",
    "prisma:generate": "prisma generate",
    "deploy:compute": "bun scripts/deploy-compute.ts",
    "resolve:migrations": "node scripts/resolve-migrations.mjs",
    "check:build-deps": "node scripts/check-build-deps.mjs"
  },
  "keywords": [
    "nestjs",
    "api",
    "vellbase"
  ],
  "author": "Vellbase Team",
  "license": "MIT",
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^12.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@prisma/client": "^6.19.3",
    "@prisma/management-api-sdk": "^1.51.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.2.0",
    "@types/uuid": "^10.0.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "prisma": "^6.19.3",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.3",
    "uuid": "^8.3.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.spec.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@prisma/compute-sdk": "^0.36.0",
    "@types/express": "^5.0.6",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^29.5.14",
    "@types/redis": "^4.0.10",
    "@types/supertest": "^2.0.16",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
