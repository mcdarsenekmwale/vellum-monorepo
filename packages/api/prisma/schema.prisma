generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                         String                       @id @default(uuid())
  email                      String                       @unique
  emailVerified              DateTime?
  passwordHash               String
  resetToken                 String?                      @unique
  resetTokenExpiresAt        DateTime?
  verificationToken          String?                      @unique
  verificationTokenExpiresAt DateTime?
  handle                     String                       @unique
  name                       String
  avatar                     String?
  bio                        String?
  website                    String?
  location                   String?
  publication                String?
  role                       Role                         @default(USER)
  isActive                   Boolean                      @default(true)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  deletedAt                  DateTime?
  apiKeys                    ApiKey[]                     @relation("ApiKeyUser")
  articles                   Article[]                    @relation("ArticleAuthor")
  auditLogs                  AuditLog[]                   @relation("AuditLogUser")
  bookmarks                  Bookmark[]                   @relation("BookmarkUser")
  comments                   Comment[]                    @relation("CommentAuthor")
  followers                  Follow[]                     @relation("Followers")
  following                  Follow[]                     @relation("Following")
  highlights                 Highlight[]                  @relation("HighlightAuthor")
  likes                      Like[]                       @relation("LikeUser")
  mediaUploads               Media[]                      @relation("MediaUploader")
  notifications              Notification[]               @relation("NotificationUser")
  refreshTokens              RefreshToken[]               @relation("RefreshTokenUser")
  sessions                   Session[]                    @relation("SessionUser")
  stories                    Story[]                      @relation("StoryAuthor")
  storyViews                 StoryView[]                  @relation("StoryViewViewer")
  settings                   UserSettings?                @relation("UserSettings")
  reports                    Report[]                     @relation("ReportReporter")
  supportTickets             SupportTicket[]              @relation("SupportTicketUser")
  assignedTickets            SupportTicket[]              @relation("SupportTicketAssignee")
  roleAssignments            UserRoleAssignment[]         @relation("UserRoleAssignments")
  permissionOverrides        UserPermissionOverride[]     @relation("UserPermissionOverrides")
  roleHistory                RoleAssignmentHistory[]      @relation("RoleAssignmentHistory")
  supportAgent               SupportAgent?                @relation("SupportAgentUser")
  ticketMessages             TicketMessage[]              @relation("TicketMessageAuthor")
  ticketNotes                TicketInternalNote[]         @relation("TicketNoteAuthor")
  ticketAttachments          TicketAttachment[]           @relation("TicketAttachmentUploader")
  ticketAssignments          TicketAssignment[]           @relation("TicketAssignmentAgent")
  ticketStatusChanges        TicketStatusHistory[]        @relation("TicketStatusChanger")
  activityLogs               ActivityLog[]                @relation("ActivityLogUser")
  helpArticleVersions        HelpArticleVersion[]         @relation("HelpArticleVersionAuthor")
  roleRequestsSubmitted      RolePermissionRequest[]      @relation("RoleRequestRequester")
  roleRequestsReviewed       RolePermissionRequest[]      @relation("RoleRequestReviewer")
  accessRequestsSubmitted    AccessRequest[]              @relation("AccessRequestRequester")
  accessRequestsReviewed     AccessRequest[]              @relation("AccessRequestReviewer")
  accessRequestEvents        AccessRequestEvent[]
  resourceAccess             UserResourceAccess[]         @relation("UserResourceAccessUser")
  roleRequestEvents          RolePermissionRequestEvent[]
  // Phase 1 — inverses for department-head / team-lead named relations
  supportDepartmentsHead     SupportDepartment[]          @relation("SupportDepartmentHead")
  supportTeamsLead           SupportTeam[]                @relation("SupportTeamLead")

  @@index([handle])
  @@index([email])
  @@index([role])
  @@index([deletedAt])
  @@index([isActive, deletedAt])
}

model UserSettings {
  id                 String                   @id @default(uuid())
  userId             String                   @unique
  emailNotifications Boolean                  @default(true)
  pushNotifications  Boolean                  @default(true)
  emailMarketing     Boolean                  @default(false)
  allowComments      Boolean                  @default(true)
  allowLikes         Boolean                  @default(true)
  showOnlineStatus   Boolean                  @default(true)
  profileVisibility  String                   @default("public")
  showLikesCount     Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  user               User                     @relation("UserSettings", fields: [userId], references: [id], onDelete: Cascade)
  notificationPrefs  NotificationPreferences?
  subscription       UserSubscription?
}

model NotificationPreferences {
  id              String       @id @default(uuid())
  userSettingsId  String       @unique
  pushLikes       Boolean      @default(true)
  pushComments    Boolean      @default(true)
  pushReplies     Boolean      @default(true)
  pushFollows     Boolean      @default(true)
  pushMentions    Boolean      @default(true)
  pushNewArticles Boolean      @default(false)
  pushSystem      Boolean      @default(true)
  emailDigest     Boolean      @default(true)
  emailMarketing  Boolean      @default(false)
  soundsEnabled   Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  userSettings    UserSettings @relation(fields: [userSettingsId], references: [id], onDelete: Cascade)
}

model UserSubscription {
  id                String       @id @default(uuid())
  userId            String       @unique
  planName          String       @default("Free")
  status            String       @default("active")
  renewalDate       DateTime?
  cancelAtPeriodEnd Boolean      @default(false)
  aiDrafts          Int          @default(5)
  customDomain      Boolean      @default(false)
  analytics         Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  userSettings      UserSettings @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

model FaqItem {
  id        String   @id @default(uuid())
  category  String
  question  String   @db.Text
  answer    String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category])
}

model Article {
  id            String    @id @default(uuid())
  slug          String    @unique
  title         String
  excerpt       String
  body          String[]
  cover         String?
  readMinutes   Int
  categoryId    String
  authorId      String
  likesCount    Int       @default(0)
  views         Int       @default(0)
  shares        Int       @default(0)
  featured      Boolean   @default(false)
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  commentsCount Int       @default(0)
  author        User      @relation("ArticleAuthor", fields: [authorId], references: [id])
  category      Category  @relation("ArticleCategory", fields: [categoryId], references: [id])

  @@index([slug])
  @@index([authorId])
  @@index([categoryId])
  @@index([featured])
  @@index([isPublished])
}

model Highlight {
  id            String    @id @default(uuid())
  title         String
  cover         String?
  videoUrl      String?
  thumbnailUrl  String?
  handle        String
  authorId      String?
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  shares        Int       @default(0)
  description   String?
  music         String?
  aspectRatio   Float?    @default(1.777)
  duration      Int?
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  comments      Comment[] @relation("HighlightComments")
  author        User?     @relation("HighlightAuthor", fields: [authorId], references: [id])

  @@index([handle])
  @@index([authorId])
  @@index([isPublished])
}

model Story {
  id        String      @id @default(uuid())
  authorId  String
  image     String
  caption   String?
  duration  Int         @default(5000)
  createdAt DateTime    @default(now())
  expiresAt DateTime    @default(dbgenerated("(now() + '24:00:00'::interval)"))
  author    User        @relation("StoryAuthor", fields: [authorId], references: [id])
  views     StoryView[] @relation("StoryView")

  @@index([authorId])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(uuid())
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())
  story    Story    @relation("StoryView", fields: [storyId], references: [id])
  viewer   User     @relation("StoryViewViewer", fields: [viewerId], references: [id])

  @@unique([storyId, viewerId])
}

model Comment {
  id          String     @id @default(uuid())
  articleSlug String?
  highlightId String?
  authorId    String
  body        String
  parentId    String?
  likesCount  Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  author      User       @relation("CommentAuthor", fields: [authorId], references: [id])
  highlight   Highlight? @relation("HighlightComments", fields: [highlightId], references: [id])
  parent      Comment?   @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[]  @relation("CommentReplies")

  @@index([articleSlug])
  @@index([highlightId])
  @@index([authorId])
  @@index([parentId])
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  tint     String    @default("#e5e5e5")
  slug     String    @unique
  articles Article[] @relation("ArticleCategory")

  @@index([slug])
}

model Like {
  id          String   @id @default(uuid())
  userId      String
  articleSlug String?
  highlightId String?
  commentId   String?
  createdAt   DateTime @default(now())
  user        User     @relation("LikeUser", fields: [userId], references: [id])

  @@unique([userId, articleSlug])
  @@unique([userId, highlightId])
  @@unique([userId, commentId])
  @@index([userId])
}

model Bookmark {
  id          String   @id @default(uuid())
  userId      String
  articleSlug String?
  highlightId String?
  createdAt   DateTime @default(now())
  user        User     @relation("BookmarkUser", fields: [userId], references: [id])

  @@unique([userId, articleSlug])
  @@unique([userId, highlightId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Followers", fields: [followerId], references: [id])
  following   User     @relation("Following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  actorId      String?
  kind         NotificationKind
  articleSlug  String?
  highlightId  String?
  commentId    String?
  body         String?
  metadata     Json?
  read         Boolean          @default(false)
  readAt       DateTime?
  scheduledFor DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation("NotificationUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  deviceInfo String?
  createdAt  DateTime @default(now())
  user       User     @relation("RefreshTokenUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User     @relation("SessionUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Media {
  id           String    @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  type         MediaType
  url          String
  thumbnailUrl String?
  width        Int?
  height       Int?
  metadata     Json?
  uploadedBy   String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  uploader     User      @relation("MediaUploader", fields: [uploadedBy], references: [id])

  @@index([uploadedBy])
  @@index([type])
}

model Webhook {
  id                String        @id @default(uuid())
  name              String
  type              WebhookType   @default(OUTGOING)
  url               String
  secret            String?
  format            WebhookFormat @default(JSON)
  events            String[]      @default([])
  headers           Json?
  isActive          Boolean       @default(true)
  lastTriggeredAt   DateTime?
  failureCount      Int           @default(0)
  // Outgoing webhook specific (retry policy)
  retryMaxAttempts  Int           @default(3)
  retryBackoffDelay Int           @default(1000)
  // Incoming webhook specific (security)
  allowedIps        String[]      @default([])
  requiresAuth      Boolean       @default(true)
  // Teams integration
  teamsChannelId    String?
  teamsTeamId       String?
  teamsCardType     TeamsCardType? @default(MESSAGE)
  teamsCardTemplate Json?
  // Audit
  createdBy         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  logs              WebhookLog[]  @relation("WebhookLog")

  @@index([type])
  @@index([isActive])
  @@index([createdBy])
  @@index([createdAt])
}

model WebhookLog {
  id          String     @id @default(uuid())
  webhookId   String?
  type        WebhookLogType @default(REQUEST)
  event       String?
  statusCode  Int?
  payload     Json?
  response    Json?
  headers     Json?
  durationMs  Int?
  errorMessage String?
  attempt     Int        @default(1)
  timestamp   DateTime   @default(now())
  webhook     Webhook?   @relation("WebhookLog", fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([type])
  @@index([event])
  @@index([timestamp])
  @@index([webhookId, timestamp])
}

model WebhookTemplate {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  description String?
  category    String       @default("general") // "teams" | "slack" | "general" | "custom"
  type        WebhookType  @default(OUTGOING)
  format      WebhookFormat @default(JSON)
  config      Json         // template config: url placeholder, headers, card template, events
  variables   String[]     @default([]) // template variable names
  isBuiltIn   Boolean      @default(false)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([slug])
}

enum WebhookType {
  INCOMING
  OUTGOING
}

enum WebhookFormat {
  JSON
  FORM
  XML
  PLAIN
}

enum WebhookLogType {
  REQUEST
  RESPONSE
  ERROR
}

enum TeamsCardType {
  MESSAGE
  ADAPTIVE
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  metadata   Json? // Additional metadata (description, etc.)
  changes    Json? // Field changes (old/new values)
  success    Boolean  @default(true)
  ipAddress  String?
  userAgent  String?
  location   String? // Geographic location from IP
  createdAt  DateTime @default(now())
  user       User?    @relation("AuditLogUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([success])
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  key        String    @unique
  userId     String?
  scopes     String[]
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       User?     @relation("ApiKeyUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([key])
}

model Report {
  id           String    @id @default(uuid())
  targetType   String // "Article" | "Highlight" | "Comment" | "User"
  targetId     String
  reason       String // "spam" | "harassment" | "copyright" | "inappropriate" | "other"
  reporterId   String
  status       String    @default("open") // "open" | "reviewing" | "resolved" | "dismissed"
  priority     String    @default("medium") // "low" | "medium" | "high" | "critical"
  aiScore      Int? // AI risk score (0-100)
  aiCategory   String? // AI detected category
  notes        String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  reporter User @relation("ReportReporter", fields: [reporterId], references: [id])

  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId])
  @@index([createdAt])
}

model Tag {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  @@index([slug])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  description String
  enabled     Boolean  @default(false)
  rollout     Int      @default(0) // 0-100 percentage
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String   @default("general")
  description String   @default("")
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
  @@index([category])
  @@index([version])
}

model Advertisement {
  id          String    @id @default(uuid())
  name        String
  status      String    @default("draft") // "draft" | "active" | "paused" | "completed"
  impressions Int       @default(0)
  clicks      Int       @default(0)
  spend       Float     @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AIAgent {
  id          String    @id @default(uuid())
  name        String
  description String?
  model       String    @default("gpt-4")
  status      String    @default("idle") // "idle" | "running" | "error" | "disabled"
  runs        Int       @default(0)
  lastRunAt   DateTime?
  config      Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

model BackgroundJob {
  id        String   @id @default(uuid())
  name      String
  queue     String   @default("default")
  status    String   @default("pending") // "pending" | "running" | "success" | "failed" | "retry"
  duration  Int? // milliseconds
  error     String?
  payload   Json?
  ranAt     DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([status])
  @@index([queue])
  @@index([ranAt])
}

enum Role {
  GUEST
  USER
  CREATOR
  MODERATOR
  SUPPORT_ADMIN
  ADMIN
  PLATFORM_ADMIN
  SUPER_ADMIN
}

enum NotificationKind {
  LIKE
  COMMENT
  REPLY
  FOLLOW
  BOOKMARK
  MENTION
  SYSTEM
  ROLE_REQUEST_SUBMITTED
  ROLE_REQUEST_APPROVED
  ROLE_REQUEST_REJECTED
  ROLE_REQUEST_EXPIRED
}

enum RolePermissionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum RolePermissionRequestType {
  PERMANENT
  TEMPORARY
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model HelpArticle {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  content     String[]
  category    String // "Basics" | "Access" | "Trust & Safety" | "Developers" | "Analytics" | "AI"
  icon        String // icon name like "BookOpen", "Users", etc.
  readMinutes Int      @default(3)
  popular     Boolean  @default(false)
  views       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isPublished])
}

model SupportTicket {
  id                String         @id @default(uuid())
  ticketNumber      String         @unique
  subject           String
  message           String
  description       String?
  type              TicketType     @default(CUSTOMER)
  priority          TicketPriority @default(MEDIUM)
  status            TicketStatus   @default(NEW)
  userId            String
  assigneeId        String?
  departmentId      String?
  teamId            String?
  categoryId        String?
  slaPolicyId       String?
  dueAt             DateTime?
  firstResponseAt   DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  reopenedAt        DateTime?
  satisfaction      Int?
  interactionsCount Int?           @default(0)
  slaMetResponse    Boolean?
  slaMetResolution  Boolean?
  version           Int            @default(1)
  metadata          Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  user           User                  @relation("SupportTicketUser", fields: [userId], references: [id])
  assignee       User?                 @relation("SupportTicketAssignee", fields: [assigneeId], references: [id])
  department     SupportDepartment?    @relation(fields: [departmentId], references: [id])
  team           SupportTeam?          @relation(fields: [teamId], references: [id])
  category       TicketCategory?       @relation(fields: [categoryId], references: [id])
  slaPolicy      SlaPolicy?            @relation(fields: [slaPolicyId], references: [id])
  messages       TicketMessage[]
  internalNotes  TicketInternalNote[]
  attachments    TicketAttachment[]
  assignments    TicketAssignment[]
  statusHistory  TicketStatusHistory[]
  tagAssignments TicketTagAssignment[]
  watchers       TicketWatcher[]

  @@index([userId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([departmentId])
  @@index([teamId])
  @@index([categoryId])
  @@index([ticketNumber])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([slaMetResponse])
  @@index([slaMetResolution])
}

// ─── Enterprise RBAC ───────────────────────────────────────────────────────────

model PermissionGroup {
  id          String       @id @default(uuid())
  key         String       @unique
  name        String
  description String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  permissions Permission[]

  @@index([key])
}

model Permission {
  id              String                   @id @default(uuid())
  key             String                   @unique
  name            String
  description     String?
  groupId         String
  sortOrder       Int                      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  deletedAt       DateTime?
  group           PermissionGroup          @relation(fields: [groupId], references: [id])
  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@index([key])
  @@index([groupId])
}

model RbacRole {
  id              String                  @id @default(uuid())
  key             String                  @unique
  name            String
  description     String?
  isSystem        Boolean                 @default(false)
  isActive        Boolean                 @default(true)
  parentId        String?
  rank            Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deletedAt       DateTime?
  parent          RbacRole?               @relation("RoleInheritance", fields: [parentId], references: [id])
  children        RbacRole[]              @relation("RoleInheritance")
  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]
  roleHistory     RoleAssignmentHistory[]

  @@index([key])
  @@index([isSystem])
  @@index([parentId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  role         RbacRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id         String    @id @default(uuid())
  userId     String
  roleId     String
  isPrimary  Boolean   @default(false)
  expiresAt  DateTime?
  assignedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)
  role       RbacRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([expiresAt])
}

model UserPermissionOverride {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  granted      Boolean
  reason       String?
  expiresAt    DateTime?
  grantedBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation("UserPermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@index([expiresAt])
}

model RoleAssignmentHistory {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  action     String
  assignedBy String?
  reason     String?
  createdAt  DateTime @default(now())
  user       User     @relation("RoleAssignmentHistory", fields: [userId], references: [id], onDelete: Cascade)
  role       RbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([createdAt])
}

// ─── Role / Permission Request Center ──────────────────────────────────────────

model RolePermissionRequest {
  id                    String                       @id @default(uuid())
  requesterId           String
  reviewerId            String?
  requestedRoleKey      String
  type                  RolePermissionRequestType
  status                RolePermissionRequestStatus  @default(PENDING)
  justification         String                       @db.Text
  adminJustification    String?                      @db.Text
  startsAt              DateTime?
  expiresAt             DateTime?
  reviewedAt            DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  // Reverse pointer to any assignments created on APPROVED (auditability)
  resultingAssignmentId String?
  history               RolePermissionRequestEvent[]
  requester             User                         @relation("RoleRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer              User?                        @relation("RoleRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  // Avoid duplicate open requests for the same role
  @@unique([requesterId, requestedRoleKey, status], name: "RolePermissionRequest_requester_rolekey_status_unique")
  @@index([requesterId])
  @@index([reviewerId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([expiresAt])
}

model RolePermissionRequestEvent {
  id         String                      @id @default(uuid())
  requestId  String
  actorId    String?
  transition RolePermissionRequestStatus // resulting status after event
  reason     String?                     @db.Text
  metadata   Json?
  createdAt  DateTime                    @default(now())
  request    RolePermissionRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor      User?                       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([actorId])
  @@index([createdAt])
}

// ─── Access Control Center (resource-level access requests) ────────────────────

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AccessRequestType {
  PERMANENT
  TEMPORARY
}

model AccessRequest {
  id                 String               @id @default(uuid())
  requesterId        String
  reviewerId         String?
  resourceType       String
  resourceId         String?
  permissionKey      String
  type               AccessRequestType
  status             AccessRequestStatus  @default(PENDING)
  justification      String               @db.Text
  adminJustification String?              @db.Text
  startsAt           DateTime?
  expiresAt          DateTime?
  reviewedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  history            AccessRequestEvent[]
  requester          User                 @relation("AccessRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer           User?                @relation("AccessRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([requesterId, resourceType, permissionKey, status], name: "AccessRequest_requester_resource_perm_status_unique")
  @@index([requesterId])
  @@index([reviewerId])
  @@index([status])
  @@index([type])
  @@index([resourceType])
  @@index([permissionKey])
  @@index([createdAt])
  @@index([expiresAt])
}

model AccessRequestEvent {
  id         String              @id @default(uuid())
  requestId  String
  actorId    String?
  transition AccessRequestStatus
  reason     String?             @db.Text
  metadata   Json?
  createdAt  DateTime            @default(now())
  request    AccessRequest       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor      User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@index([actorId])
  @@index([createdAt])
}

model ResourcePermission {
  id             String   @id @default(uuid())
  resourceType   String
  permissionKey  String   @unique
  permissionName String
  description    String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([resourceType])
}

model UserResourceAccess {
  id            String    @id @default(uuid())
  userId        String
  resourceType  String
  resourceId    String?
  permissionKey String
  grantedAt     DateTime  @default(now())
  grantedBy     String?
  expiresAt     DateTime?
  isActive      Boolean   @default(true)
  user          User      @relation("UserResourceAccessUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceType, permissionKey], name: "UserResourceAccess_user_resource_perm_unique")
  @@index([userId])
  @@index([resourceType])
  @@index([permissionKey])
  @@index([expiresAt])
}

model SupportDepartment {
  id                      String    @id @default(uuid())
  key                     String    @unique
  // name is globally unique across org
  name                    String    @unique
  description             String?
  email                   String?
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?
  // ─── Phase 1 additions ─────────────────────────────────────────────────────
  // Department head/manager (User.id). Nullable — an open headcount is valid.
  headId                  String?
  head                    User?     @relation("SupportDepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  // SLA targets for this department
  firstResponseSlaMinutes Int       @default(30)
  resolutionSlaMinutes    Int       @default(1440) // 24 h default
  slaAdherenceTargetPct   Int       @default(95) // 0..100
  // Business hours expressed as minutes from midnight in the dept's timezone
  businessHoursStartMin   Int       @default(540) // 09:00
  businessHoursEndMin     Int       @default(1020) // 17:00
  // ISO weekday mask: 0 = Sun .. 6 = Sat; default Mon–Fri
  businessDays            Int[]     @default([1, 2, 3, 4, 5])
  timezone                String    @default("UTC") // IANA timezone string
  // Optional budgeting / capacity fields
  budgetAllocated         Decimal?
  resourceCapacityFte     Decimal?

  teams       SupportTeam[]
  agents      SupportAgent[]
  tickets     SupportTicket[]
  slaPolicies SlaPolicy[]

  @@index([key])
  @@index([name])
  @@index([isActive])
}

model SupportTeam {
  id                            String                       @id @default(uuid())
  departmentId                  String
  // Team name unique within a department.
  name                          String
  description                   String?
  isActive                      Boolean                      @default(true)
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt
  deletedAt                     DateTime?
  department                    SupportDepartment            @relation(fields: [departmentId], references: [id])
  // Legacy single-team FK on SupportAgent; kept so existing queries work
  agents                        SupportAgent[]
  // ─── Phase 1 additions ─────────────────────────────────────────────────────
  // Team lead (references User.id, usually but not always an agent user)
  leadId                        String?
  lead                          User?                        @relation("SupportTeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  // SLA: inherit=true means use department values (override fields ignored)
  slaInheritFromDept            Boolean                      @default(true)
  firstResponseSlaMinutes       Int?
  resolutionSlaMinutes          Int?
  // Business-hours: inherit=true means use the department's settings
  businessHoursInherit          Boolean                      @default(true)
  businessHoursStartMin         Int?
  businessHoursEndMin           Int?
  // Prisma doesn't support nullable list types; use businessHoursInherit to decide whether to read these.
  // An empty array signals "no override" when businessHoursInherit=true.
  businessDays                  Int[]                        @default([])
  timezone                      String?
  // Capacity settings per team
  maxTicketsPerAgent            Int                          @default(10)
  concurrentTicketLimitPerAgent Int                          @default(4)
  // Skill specialization label: technical | billing | product | ...
  skillSpecialization           String?
  // M:N memberships with agents (history + primary flag)
  memberships                   SupportAgentTeamMembership[]
  // Tickets directly routed to this team (opposite of SupportTicket.team)
  assignedTickets               SupportTicket[]

  @@unique([departmentId, name])
  @@index([departmentId])
  @@index([isActive])
}

model SupportAgent {
  id            String                       @id @default(uuid())
  userId        String                       @unique
  departmentId  String?
  teamId        String?
  status        AgentStatus                  @default(OFFLINE)
  maxTickets    Int                          @default(10)
  activeTickets Int                          @default(0)
  skills        String[]
  isActive      Boolean                      @default(true)
  vacationUntil DateTime?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  deletedAt     DateTime?
  user          User                         @relation("SupportAgentUser", fields: [userId], references: [id])
  department    SupportDepartment?           @relation(fields: [departmentId], references: [id])
  team          SupportTeam?                 @relation(fields: [teamId], references: [id])
  // ─── Phase 1 additions ─────────────────────────────────────────────────────
  memberships   SupportAgentTeamMembership[]

  @@index([departmentId])
  @@index([teamId])
  @@index([status])
}

/**
 * M:N join table tracking which agents belong to which teams,
 * including historical memberships and primary-team designation.
 * Invariants (enforced by the service layer):
 * • An agent may have only one ACTIVE primary team
 * (SupportAgentTeamMembership where agentId=X AND endDate IS NULL AND isPrimary=true → unique).
 * • An agent/team pair has at most one open (endDate IS NULL) row at any time.
 */
model SupportAgentTeamMembership {
  id         String    @id @default(uuid())
  agentId    String
  teamId     String
  isPrimary  Boolean   @default(false)
  startDate  DateTime  @default(now())
  endDate    DateTime?
  assignedBy String? // User.id of the admin/manager performing the assignment
  assignedAt DateTime  @default(now())

  agent SupportAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  team  SupportTeam  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([agentId, teamId, endDate]) // prevent duplicate active memberships
  @@index([agentId, isPrimary])
  @@index([teamId, isPrimary])
  @@index([agentId, endDate])
  @@index([teamId, endDate])
}

model TicketCategory {
  id          String          @id @default(uuid())
  key         String          @unique
  name        String
  description String?
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
