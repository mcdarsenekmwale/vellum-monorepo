enum TicketType {
  CUSTOMER
  INTERNAL
  BUG_REPORT
  FEATURE_REQUEST
  TECHNICAL
  BILLING
  ABUSE
  MODERATION
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  EMERGENCY
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  WAITING_ON_INTERNAL
  ESCALATED
  RESOLVED
  CLOSED
  REOPENED
}

enum AgentStatus {
  ONLINE
  BUSY
  AWAY
  OFFLINE
}
