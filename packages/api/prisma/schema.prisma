generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  emailVerified DateTime?
  passwordHash  String
  resetToken    String?        @unique
  resetTokenExpiresAt DateTime?
  verificationToken    String?  @unique
  verificationTokenExpiresAt DateTime?
  handle        String         @unique
  name          String
  avatar        String?
  bio           String?
  website       String?
  location      String?
  publication   String?
  role          Role           @default(USER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  apiKeys       ApiKey[]       @relation("ApiKeyUser")
  articles      Article[]      @relation("ArticleAuthor")
  auditLogs     AuditLog[]     @relation("AuditLogUser")
  bookmarks     Bookmark[]     @relation("BookmarkUser")
  comments      Comment[]      @relation("CommentAuthor")
  followers     Follow[]       @relation("Followers")
  following     Follow[]       @relation("Following")
  highlights    Highlight[]    @relation("HighlightAuthor")
  likes         Like[]         @relation("LikeUser")
  mediaUploads  Media[]        @relation("MediaUploader")
  notifications Notification[] @relation("NotificationUser")
  refreshTokens RefreshToken[] @relation("RefreshTokenUser")
  sessions      Session[]      @relation("SessionUser")
  stories       Story[]        @relation("StoryAuthor")
  storyViews    StoryView[]    @relation("StoryViewViewer")
  settings      UserSettings?  @relation("UserSettings")
  reports       Report[]       @relation("ReportReporter")
  supportTickets SupportTicket[] @relation("SupportTicketUser")
  assignedTickets SupportTicket[] @relation("SupportTicketAssignee")
  roleAssignments UserRoleAssignment[] @relation("UserRoleAssignments")
  permissionOverrides UserPermissionOverride[] @relation("UserPermissionOverrides")
  roleHistory     RoleAssignmentHistory[] @relation("RoleAssignmentHistory")
  supportAgent    SupportAgent?  @relation("SupportAgentUser")
  ticketMessages  TicketMessage[] @relation("TicketMessageAuthor")
  ticketNotes     TicketInternalNote[] @relation("TicketNoteAuthor")
  ticketAttachments TicketAttachment[] @relation("TicketAttachmentUploader")
  ticketAssignments TicketAssignment[] @relation("TicketAssignmentAgent")
  ticketStatusChanges TicketStatusHistory[] @relation("TicketStatusChanger")
  activityLogs    ActivityLog[]  @relation("ActivityLogUser")
  helpArticleVersions HelpArticleVersion[] @relation("HelpArticleVersionAuthor")

  @@index([handle])
  @@index([email])
  @@index([role])
}

model UserSettings {
  id                 String   @id @default(uuid())
  userId             String   @unique
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  emailMarketing     Boolean  @default(false)
  allowComments      Boolean  @default(true)
  allowLikes         Boolean  @default(true)
  showOnlineStatus   Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation("UserSettings", fields: [userId], references: [id], onDelete: Cascade)
}

model Article {
  id            String    @id @default(uuid())
  slug          String    @unique
  title         String
  excerpt       String
  body          String[]
  cover         String?
  readMinutes   Int
  categoryId    String
  authorId      String
  likesCount    Int       @default(0)
  views         Int       @default(0)
  shares        Int       @default(0)
  featured      Boolean   @default(false)
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  commentsCount Int       @default(0)
  author        User      @relation("ArticleAuthor", fields: [authorId], references: [id])
  category      Category  @relation("ArticleCategory", fields: [categoryId], references: [id])

  @@index([slug])
  @@index([authorId])
  @@index([categoryId])
  @@index([featured])
  @@index([isPublished])
}

model Highlight {
  id            String    @id @default(uuid())
  title         String
  cover         String?
  videoUrl      String?
  thumbnailUrl  String?
  handle        String
  authorId      String?
  likesCount    Int       @default(0)
  commentsCount Int       @default(0)
  shares        Int       @default(0)
  description   String?
  music         String?
  aspectRatio   Float?    @default(1.777)
  duration      Int?
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  comments      Comment[] @relation("HighlightComments")
  author        User?     @relation("HighlightAuthor", fields: [authorId], references: [id])

  @@index([handle])
  @@index([authorId])
  @@index([isPublished])
}

model Story {
  id        String      @id @default(uuid())
  authorId  String
  image     String
  caption   String?
  duration  Int         @default(5000)
  createdAt DateTime    @default(now())
  expiresAt DateTime    @default(dbgenerated("(now() + '24:00:00'::interval)"))
  author    User        @relation("StoryAuthor", fields: [authorId], references: [id])
  views     StoryView[] @relation("StoryView")

  @@index([authorId])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(uuid())
  storyId  String
  viewerId String
  viewedAt DateTime @default(now())
  story    Story    @relation("StoryView", fields: [storyId], references: [id])
  viewer   User     @relation("StoryViewViewer", fields: [viewerId], references: [id])

  @@unique([storyId, viewerId])
}

model Comment {
  id          String     @id @default(uuid())
  articleSlug String?
  highlightId String?
  authorId    String
  body        String
  parentId    String?
  likesCount  Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  author      User       @relation("CommentAuthor", fields: [authorId], references: [id])
  highlight   Highlight? @relation("HighlightComments", fields: [highlightId], references: [id])
  parent      Comment?   @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[]  @relation("CommentReplies")

  @@index([articleSlug])
  @@index([highlightId])
  @@index([authorId])
  @@index([parentId])
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  tint     String    @default("#e5e5e5")
  slug     String    @unique
  articles Article[] @relation("ArticleCategory")

  @@index([slug])
}

model Like {
  id          String   @id @default(uuid())
  userId      String
  articleSlug String?
  highlightId String?
  commentId   String?
  createdAt   DateTime @default(now())
  user        User     @relation("LikeUser", fields: [userId], references: [id])

  @@unique([userId, articleSlug])
  @@unique([userId, highlightId])
  @@unique([userId, commentId])
  @@index([userId])
}

model Bookmark {
  id          String   @id @default(uuid())
  userId      String
  articleSlug String?
  highlightId String?
  createdAt   DateTime @default(now())
  user        User     @relation("BookmarkUser", fields: [userId], references: [id])

  @@unique([userId, articleSlug])
  @@unique([userId, highlightId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Followers", fields: [followerId], references: [id])
  following   User     @relation("Following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  actorId      String?
  kind         NotificationKind
  articleSlug  String?
  highlightId  String?
  commentId    String?
  body         String?
  metadata     Json?
  read         Boolean          @default(false)
  readAt       DateTime?
  scheduledFor DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  user         User             @relation("NotificationUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  deviceInfo String?
  createdAt  DateTime @default(now())
  user       User     @relation("RefreshTokenUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  user         User     @relation("SessionUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([expiresAt])
}

model Media {
  id           String    @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  type         MediaType
  url          String
  thumbnailUrl String?
  width        Int?
  height       Int?
  metadata     Json?
  uploadedBy   String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  uploader     User      @relation("MediaUploader", fields: [uploadedBy], references: [id])

  @@index([uploadedBy])
  @@index([type])
}

model Webhook {
  id          String       @id @default(uuid())
  name        String
  url         String
  secret      String
  events      String[]
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  webhookLogs WebhookLog[] @relation("WebhookLog")
}

model WebhookLog {
  id         String    @id @default(uuid())
  webhookId  String?
  event      String
  payload    Json
  statusCode Int?
  response   String?
  error      String?
  createdAt  DateTime  @default(now())
  webhook    Webhook?  @relation("WebhookLog", fields: [webhookId], references: [id])

  @@index([webhookId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  metadata   Json?    // Additional metadata (description, etc.)
  changes    Json?    // Field changes (old/new values)
  success    Boolean  @default(true)
  ipAddress  String?
  userAgent  String?
  location   String?  // Geographic location from IP
  createdAt  DateTime @default(now())
  user       User?    @relation("AuditLogUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([success])
}

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  key        String    @unique
  userId     String?
  scopes     String[]
  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       User?     @relation("ApiKeyUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([key])
}

model Report {
  id          String   @id @default(uuid())
  targetType  String   // "Article" | "Highlight" | "Comment" | "User"
  targetId    String
  reason      String   // "spam" | "harassment" | "copyright" | "inappropriate" | "other"
  reporterId  String
  status      String   @default("open") // "open" | "reviewing" | "resolved" | "dismissed"
  priority    String   @default("medium") // "low" | "medium" | "high" | "critical"
  aiScore     Int?     // AI risk score (0-100)
  aiCategory  String?  // AI detected category
  notes       String?
  resolvedById String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter    User     @relation("ReportReporter", fields: [reporterId], references: [id])

  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId])
  @@index([createdAt])
}

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())

  @@index([slug])
}

model FeatureFlag {
  id        String   @id @default(uuid())
  key       String   @unique
  description String
  enabled   Boolean  @default(false)
  rollout   Int      @default(0) // 0-100 percentage
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String   @default("general")
  description String   @default("")
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([key])
  @@index([category])
  @@index([version])
}

model Advertisement {
  id          String    @id @default(uuid())
  name        String
  status      String    @default("draft") // "draft" | "active" | "paused" | "completed"
  impressions Int       @default(0)
  clicks      Int       @default(0)
  spend       Float     @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AIAgent {
  id          String   @id @default(uuid())
  name        String
  description String?
  model       String   @default("gpt-4")
  status      String   @default("idle") // "idle" | "running" | "error" | "disabled"
  runs        Int      @default(0)
  lastRunAt   DateTime?
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model BackgroundJob {
  id        String   @id @default(uuid())
  name      String
  queue     String   @default("default")
  status    String   @default("pending") // "pending" | "running" | "success" | "failed" | "retry"
  duration  Int?     // milliseconds
  error     String?
  payload   Json?
  ranAt     DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([status])
  @@index([queue])
  @@index([ranAt])
}

enum Role {
  ADMIN
  MODERATOR
  CREATOR
  USER
  GUEST
}

enum NotificationKind {
  LIKE
  COMMENT
  REPLY
  FOLLOW
  BOOKMARK
  MENTION
  SYSTEM
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model HelpArticle {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  description String
  content     String[]
  category    String   // "Basics" | "Access" | "Trust & Safety" | "Developers" | "Analytics" | "AI"
  icon        String   // icon name like "BookOpen", "Users", etc.
  readMinutes Int      @default(3)
  popular     Boolean  @default(false)
  views       Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isPublished])
}

model SupportTicket {
  id             String         @id @default(uuid())
  ticketNumber   String         @unique
  subject        String
  message        String
  description    String?
  type           TicketType     @default(CUSTOMER)
  priority       TicketPriority @default(MEDIUM)
  status         TicketStatus   @default(NEW)
  userId         String
  assigneeId     String?
  departmentId   String?
  categoryId     String?
  slaPolicyId    String?
  dueAt          DateTime?
  firstResponseAt DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  reopenedAt     DateTime?
  satisfaction   Int?
  version        Int            @default(1)
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  user           User           @relation("SupportTicketUser", fields: [userId], references: [id])
  assignee       User?          @relation("SupportTicketAssignee", fields: [assigneeId], references: [id])
  department     SupportDepartment? @relation(fields: [departmentId], references: [id])
  category       TicketCategory? @relation(fields: [categoryId], references: [id])
  slaPolicy      SlaPolicy?     @relation(fields: [slaPolicyId], references: [id])
  messages       TicketMessage[]
  internalNotes  TicketInternalNote[]
  attachments    TicketAttachment[]
  assignments    TicketAssignment[]
  statusHistory  TicketStatusHistory[]
  tagAssignments TicketTagAssignment[]
  watchers       TicketWatcher[]

  @@index([userId])
  @@index([assigneeId])
  @@index([status])
  @@index([priority])
  @@index([departmentId])
  @@index([categoryId])
  @@index([ticketNumber])
  @@index([createdAt])
  @@index([deletedAt])
}

// ─── Enterprise RBAC ───────────────────────────────────────────────────────────

model PermissionGroup {
  id          String       @id @default(uuid())
  key         String       @unique
  name        String
  description String?
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  permissions Permission[]

  @@index([key])
}

model Permission {
  id          String       @id @default(uuid())
  key         String       @unique
  name        String
  description String?
  groupId     String
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  group       PermissionGroup @relation(fields: [groupId], references: [id])
  rolePermissions RolePermission[]
  userOverrides   UserPermissionOverride[]

  @@index([key])
  @@index([groupId])
}

model RbacRole {
  id          String       @id @default(uuid())
  key         String       @unique
  name        String
  description String?
  isSystem    Boolean      @default(false)
  isActive    Boolean      @default(true)
  parentId    String?
  rank        Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  parent      RbacRole?    @relation("RoleInheritance", fields: [parentId], references: [id])
  children    RbacRole[]   @relation("RoleInheritance")
  permissions RolePermission[]
  userAssignments UserRoleAssignment[]
  roleHistory RoleAssignmentHistory[]

  @@index([key])
  @@index([isSystem])
  @@index([parentId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  granted      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  role         RbacRole   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id         String    @id @default(uuid())
  userId     String
  roleId     String
  isPrimary  Boolean   @default(false)
  expiresAt  DateTime?
  assignedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation("UserRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)
  role       RbacRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([expiresAt])
}

model UserPermissionOverride {
  id           String     @id @default(uuid())
  userId       String
  permissionId String
  granted      Boolean
  reason       String?
  expiresAt    DateTime?
  grantedBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation("UserPermissionOverrides", fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
  @@index([expiresAt])
}

model RoleAssignmentHistory {
  id         String   @id @default(uuid())
  userId     String
  roleId     String
  action     String
  assignedBy String?
  reason     String?
  createdAt  DateTime @default(now())
  user       User     @relation("RoleAssignmentHistory", fields: [userId], references: [id], onDelete: Cascade)
  role       RbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([createdAt])
}

// ─── Support Center ────────────────────────────────────────────────────────────

model SupportDepartment {
  id          String         @id @default(uuid())
  key         String         @unique
  name        String
  description String?
  email       String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  teams       SupportTeam[]
  agents      SupportAgent[]
  tickets     SupportTicket[]
  slaPolicies SlaPolicy[]

  @@index([key])
}

model SupportTeam {
  id           String            @id @default(uuid())
  name         String
  departmentId String
  description  String?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?
  department   SupportDepartment @relation(fields: [departmentId], references: [id])
  agents       SupportAgent[]

  @@index([departmentId])
}

model SupportAgent {
  id              String            @id @default(uuid())
  userId          String            @unique
  departmentId    String?
  teamId          String?
  status          AgentStatus       @default(OFFLINE)
  maxTickets      Int               @default(10)
  activeTickets   Int               @default(0)
  skills          String[]
  isActive        Boolean           @default(true)
  vacationUntil   DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  user            User              @relation("SupportAgentUser", fields: [userId], references: [id])
  department      SupportDepartment? @relation(fields: [departmentId], references: [id])
  team            SupportTeam?      @relation(fields: [teamId], references: [id])

  @@index([departmentId])
  @@index([teamId])
  @@index([status])
}

model TicketCategory {
  id          String          @id @default(uuid())
  key         String          @unique
  name        String
  description String?
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tickets     SupportTicket[]

  @@index([key])
}

model TicketTag {
  id          String              @id @default(uuid())
  name        String              @unique
  color       String              @default("#6B7280")
  createdAt   DateTime            @default(now())
  assignments TicketTagAssignment[]

  @@index([name])
}

model TicketTagAssignment {
  id       String        @id @default(uuid())
  ticketId String
  tagId    String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  tag      TicketTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([ticketId, tagId])
  @@index([ticketId])
  @@index([tagId])
}

model TicketMessage {
  id         String        @id @default(uuid())
  ticketId   String
  authorId   String
  body       String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  deletedAt  DateTime?
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User          @relation("TicketMessageAuthor", fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([authorId])
  @@index([createdAt])
}

model TicketInternalNote {
  id        String        @id @default(uuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User          @relation("TicketNoteAuthor", fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([authorId])
}

model TicketAttachment {
  id           String        @id @default(uuid())
  ticketId     String
  uploadedById String
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  createdAt    DateTime      @default(now())
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy   User          @relation("TicketAttachmentUploader", fields: [uploadedById], references: [id])

  @@index([ticketId])
}

model TicketAssignment {
  id         String        @id @default(uuid())
  ticketId   String
  agentId    String
  assignedBy String?
  reason     String?
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  endedAt    DateTime?
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  agent      User          @relation("TicketAssignmentAgent", fields: [agentId], references: [id])

  @@index([ticketId])
  @@index([agentId])
  @@index([isActive])
}

model TicketStatusHistory {
  id          String        @id @default(uuid())
  ticketId    String
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  changedById String
  reason      String?
  createdAt   DateTime      @default(now())
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy   User          @relation("TicketStatusChanger", fields: [changedById], references: [id])

  @@index([ticketId])
  @@index([createdAt])
}

model TicketWatcher {
  id        String        @id @default(uuid())
  ticketId  String
  userId    String
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, userId])
  @@index([ticketId])
  @@index([userId])
}

model SlaPolicy {
  id                  String            @id @default(uuid())
  name                String
  departmentId        String?
  priority            TicketPriority
  firstResponseMinutes Int
  resolutionMinutes   Int
  escalationMinutes   Int?
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  department          SupportDepartment? @relation(fields: [departmentId], references: [id])
  tickets             SupportTicket[]
  escalationRules     EscalationRule[]

  @@index([departmentId])
  @@index([priority])
}

model EscalationRule {
  id          String    @id @default(uuid())
  slaPolicyId String
  name        String
  triggerAfterMinutes Int
  action      String
  targetRole  String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  slaPolicy   SlaPolicy @relation(fields: [slaPolicyId], references: [id], onDelete: Cascade)

  @@index([slaPolicyId])
}

model CannedResponse {
  id          String   @id @default(uuid())
  title       String
  body        String
  category    String?
  shortcut    String?  @unique
  isActive    Boolean  @default(true)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([category])
  @@index([shortcut])
}

model HelpArticleVersion {
  id          String   @id @default(uuid())
  articleId   String
  version     Int
  title       String
  content     String[]
  authorId    String?
  changeNote  String?
  createdAt   DateTime @default(now())
  author      User?    @relation("HelpArticleVersionAuthor", fields: [authorId], references: [id])

  @@unique([articleId, version])
  @@index([articleId])
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User?    @relation("ActivityLogUser", fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum TicketType {
  CUSTOMER
  INTERNAL
  BUG_REPORT
  FEATURE_REQUEST
  TECHNICAL
  BILLING
  ABUSE
  MODERATION
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  EMERGENCY
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  WAITING_ON_INTERNAL
  ESCALATED
  RESOLVED
  CLOSED
  REOPENED
}

enum AgentStatus {
  ONLINE
  BUSY
  AWAY
  OFFLINE
}
